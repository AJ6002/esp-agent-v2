# ==============================================================================
# Industrial Maintenance Copilot & ESP APM Platform Configuration Template
# ==============================================================================

# ================================
# Application Settings
# ================================
APP_NAME=AI-Powered Industrial Intelligent Maintenance Platform
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ================================
# Database Configuration
# ================================
# Leave empty to use local SQLite for rapid prototyping, or specify PostgreSQL URI:
# Example: postgresql+psycopg://maintenance:maintenance-local-only@localhost:5432/maintenance
DATABASE_URL=
# Automatically run database migrations on application startup (development only)
AUTO_MIGRATE_ON_STARTUP=true
# Redis URL for background worker & scheduler coordination (optional in local dev)
REDIS_URL=

# ================================
# Security & Authentication
# ================================
# JWT secret key: replace with a cryptographically secure random string in production (>= 32 chars)
SECRET_KEY=change-this-to-a-random-secret-key-in-production-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================================
# AI Copilot & LLM Configuration (OpenAI-compatible)
# ================================
# Set AI_ENABLED=false to enable deterministic mock AI mode (no LLM required)
AI_ENABLED=true
# Local LLM Server (e.g. vLLM with Qwen 2.5 Coder 3B on Server 188 or 134)
LLM_API_BASE=http://192.168.1.188:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen2.5-Coder-3B-Instruct-Q4_K_M
EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_SECONDS=60
EQUIPMENT_COMMAND_TIMEOUT_SECONDS=300

# ================================
# File Storage
# ================================
# Storage backend: 'local' or 's3'
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# S3 / MinIO Object Storage (Optional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ================================
# Seed & Demo Data
# ================================
# Seed initial demonstration assets, equipment types, and fault codes on first startup
SEED_ON_STARTUP=true

# ================================
# Industrial Protocol Gateway (OPC UA, Read-Only)
# ================================
# Master switch: disabled by default
GATEWAY_ENABLED=false
# Mode: 'mock' (in-process simulator) or 'opcua' (live OPC UA server connection)
GATEWAY_MODE=mock
GATEWAY_ENDPOINT=mock://opcua-simulator
GATEWAY_POLL_INTERVAL_SECONDS=5
GATEWAY_AUTO_INGEST=true
GATEWAY_MAPPING_CONFIG=configs/opcua-node-mapping.yaml

# ================================
# OPC UA Event-Driven Subscription (DataChange, Read-Only)
# ================================
GATEWAY_SUBSCRIPTION_ENABLED=false
GATEWAY_SUBSCRIPTION_SAMPLING_MS=1000
GATEWAY_SUBSCRIPTION_DEBOUNCE_MS=1000

# ================================
# Observability & Tracing (Optional OpenTelemetry)
# ================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=industrial-maintenance-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=1.0
